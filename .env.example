# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE DUAL-MODE (Cloudflare Pages + PostgreSQL RLS):
# Se definidos, o CanisTech DogOS sincroniza automaticamente com o Supabase PostgreSQL.
# Se omitidos, opera em modo Cofre Local Seguro (Fallback Transparente).
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-supabase"
